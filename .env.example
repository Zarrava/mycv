# Public site URL used for canonical links, sitemap, and Open Graph.
# TODO: set this to the production domain before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend. All three are required before the contact form delivers email.
# TODO: create a Resend API key and verify the from-address domain.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional analytics. Leave blank to disable.
# TODO: set your Plausible domain if you want analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
